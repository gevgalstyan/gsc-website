{
  "name": "galstyans-speaking-club",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "validate:questions": "node scripts/validate-questions.mjs",
    "validate:translations": "node scripts/validate-translations.mjs",
    "test:auth": "node --experimental-strip-types --test tests/unit/*.test.ts tests/unit/*.test.mjs tests/sql/*.test.mjs",
    "test:auth:browser": "playwright test",
    "test:auth:build": "node scripts/build-auth-test.mjs",
    "prebuild": "node scripts/validate-auth-config.mjs",
    "build:auth-production": "node scripts/build-auth-production.mjs",
    "auth:check": "node --use-env-proxy scripts/check-auth-readiness.mjs",
    "postbuild": "node scripts/write-auth-build-status.mjs",
    "test:auth:configuration": "node scripts/test-auth-configuration.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.110.8",
    "lucide-react": "0.468.0",
    "next": "16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "eslint": "9.17.0",
    "eslint-config-next": "16.3.1",
    "typescript": "5.7.2"
  }
}
