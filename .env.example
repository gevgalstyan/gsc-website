# Leave these blank to use the safe demo authentication UI.
# Use only a Supabase publishable key here. Never expose a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Generate independently for every environment; never expose it to the browser.
CRON_SECRET=

# Telegram auth stays disabled until a custom Supabase OIDC provider is configured.
NEXT_PUBLIC_TELEGRAM_AUTH_ENABLED=false

# Enable only after the provider is configured and its full redirect flow is verified.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
