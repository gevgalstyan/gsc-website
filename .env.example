# The public site can render without these values, but member access requires them.
# Use only a Supabase publishable key here. Never expose a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Telegram auth stays disabled until a custom Supabase OIDC provider is configured.
NEXT_PUBLIC_TELEGRAM_AUTH_ENABLED=false

# Legacy provider flags: Google/Telegram buttons are not displayed by the email access interface.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Public Turnstile site key only. Configure its secret in Supabase Auth, never here.
# Forms fail closed when this key is absent; enable CAPTCHA in Supabase separately.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
